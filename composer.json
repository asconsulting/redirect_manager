{
    "name":"asconsulting/redirect_manager",
    "description":"URL redirection module for Contao 4.9+",
    "homepage": "https://andrewstevens.consulting",
    "keywords":["contao", "htaccess", ".htaccess", "redirect", "rewrite", "url", "301", "302"],
    "type":"contao-bundle",
    "license":"LGPL-3.0-or-later",
    "authors":[
        {
            "name":"Andrew Stevens",
            "homepage":"https://andrewstevens.consulting"
        }
    ],
    "require":{
        "php": ">=8.2",
        "contao/core-bundle": "^5.3"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RedirectManager\\": "src/"
        }
    },
	"extra": {
		"contao-manager-plugin": "RedirectManager\\ContaoManager\\Plugin"
	},
    "minimum-stability": "dev"
}
